{
  "expo": {
    "name": "OptiLigne",
    "slug": "optiligne",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "optiligne",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fr.cellulenoire.optiligne"
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0056D6",
        "foregroundImage": "./assets/icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "fr.cellulenoire.optiligne",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0056D6",
          "image": "./assets/splash-icon.png",
          "imageWidth": 100
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OptiLigne utilise la position pour vous guider sur le circuit."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d7266b6-3fda-4484-84c7-34ca590afa54"
      }
    },
    "owner": "ptijjo"
  }
}
